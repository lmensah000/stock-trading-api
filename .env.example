# ============================================================
#  TCKR — environment template
#
#  cp .env.example .env   then fill in the blanks.
#  .env is gitignored and must never be committed.
#
#  Nothing here is a working value. Every secret is blank on purpose: a
#  placeholder that happens to work is the one that reaches production
#  unnoticed, which is how the Schwab credentials in this repository's git
#  history became a standing problem. Generate your own.
# ============================================================

# ------------------------------------------------------------
#  Database
# ------------------------------------------------------------
# Used by both MySQL (to create the user) and the app (to connect).
DB_NAME=moneyteamdb
DB_USER=
DB_PASS=
MYSQL_ROOT_PASSWORD=

# ------------------------------------------------------------
#  Auth
# ------------------------------------------------------------
# At least 32 bytes, or the app refuses to start rather than issuing tokens
# that could be forged. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# ------------------------------------------------------------
#  Profile
# ------------------------------------------------------------
# dev enables SQL echoing and bind-parameter logging, which print passwords
# and PII. Never use dev for anything reachable by anyone but you.
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------
#  Bot
# ------------------------------------------------------------
# false means nothing scans and no order is ever placed. Leave it false until
# you have deliberately decided otherwise.
BOT_ENABLED=false

# The single account the bot acts as. Identity is resolved from this at
# startup, never from a request.
#
# The user must already be registered - the app will not create them, because
# that would mean choosing a password on your behalf. Register first:
#   curl -X POST http://localhost:8080/api/users/register \
#        -H 'Content-Type: application/json' \
#        -d '{"userName":"you","passWord":"..."}'
BOT_OWNER_USERNAME=

# What the paper account is funded with on first boot.
BOT_STARTING_EQUITY=100000

# The paper equity that must be reached before live trading can be ARMED.
# Required on first boot when BOT_ENABLED=true, and recorded immutably - a gate
# whose bar can be lowered later is decorative. Reaching it does not unlock
# anything by itself; unlocking is a separate, explicit act:
#   POST /api/bot/unlock  {"confirmTargetEquity": 130000}
BOT_UNLOCK_TARGET_EQUITY=

# ------------------------------------------------------------
#  Market data
# ------------------------------------------------------------
# in-memory : fixtures, no credentials, stack comes up clean
# csv       : bar files under ./data, for backtesting
# schwab    : live - do not select until the leaked credentials are rotated
MARKETDATA_PROVIDER=in-memory

# Where the csv provider looks for <TICKER>_<TIMEFRAME>.csv bar files.
# docker-compose mounts ./data read-only at /app/data.
MARKETDATA_CSV_DIR=data

# AES-256 key, base64, 32 bytes. Required only for the schwab provider; it
# encrypts the stored OAuth refresh token at rest. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------
#  Schwab
# ------------------------------------------------------------
# WARNING: the client_id and client_secret previously committed to this
# repository remain in its git history and must be treated as compromised.
# Do not paste those values here. Issue new ones at the Schwab developer
# portal first - rotating them is what actually closes the exposure.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=
